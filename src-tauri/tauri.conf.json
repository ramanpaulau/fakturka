{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fakturka",
  "version": "0.2.1",
  "identifier": "cz.fakturka.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Fakturka",
        "width": 1280,
        "height": 900,
        "minWidth": 1000
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEzNENCNjM5RTQ1RDU1RjgKUldUNFZWM2tPYlpNbzUvRFlGbzJMdkNLbWxmeDFEanRnS1NWekFhMzRZQ3BhUVdQVEJCS2dhbmcK",
      "endpoints": [
        "https://github.com/ramanpaulau/fakturka/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
